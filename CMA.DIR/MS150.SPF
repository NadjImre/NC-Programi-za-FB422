PROC  MS150
;merenje za pozicioniranje preko sredine zljeba
;za mašinu FB422, maj 2026
;korekcija - 0 samo merenje, 1 merenje sa korekcijom , 2 podesavanje/kalibracija, 3 rekalibracija
;PROMENLJIVE
;pocetna pozicija pre merenja
Def Real start_x,start_z
;brojac merenja
Def Int Brojac=0
;ravan , koordinatni sistem i alat
g18g500 t=me_tool d=me_tool_dnumber
;zapamti pocetnu poziciju
start_x=$aa_iw[x] start_z=$aa_iw[z]
stopre
;da li je podesavanje ili kalibracija
if (me_W_type==2) gotof Kalibracija
;poruka
msg("$66020")
;podizanje sonde
m=me_ProbeUp

;zauzimanje pozicije za merenje - ako ima kontakta to je greska
G0 Z=me_W_position MEAS=me_probenumber
IF($AC_MEA[me_probenumber]==1) GOTOF GRESKA
;zauzimanje pocetne tacke merenja po X u - ako ima kontakta to je greska
G0 X=me_W_diameter MEAS=me_probenumber
IF($AC_MEA[me_probenumber]==1) GOTOF GRESKA
STOPRE
;merenje zljeba
MERENJE_ZLJEBA:
;merimo u plus
G1 Z=IC(me_W_width) F=me_feed MEAS=me_probenumber
;ako ako nema kontakta greska
IF($AC_MEA[me_probenumber]==0) GOTOF GRESKA
;ako ima onda belezimo rezultat
me_W_result1=$AA_MW[Z]
;i vracamo se nazad
G0 Z=me_W_position
;i merimo u suprotnom smeru
G1 Z=IC(-me_W_width) F=me_feed MEAS=me_probenumber
;ako nemamo kontakt to je greska
IF($AC_MEA[me_probenumber]==0) GOTOF GRESKA
;ako ima onda belezimo rezultat
me_W_result2=$AA_MW[Z]
;i vracamo se nazad
G0 Z=me_W_position
;proracun sredine
me_W_result = me_W_position - 0.5*(me_W_result1 + me_W_result2)
;ispis poruke
msg("$66021 "<<me_W_result)
;vracanje na pocetnu tacku
g0 x=start_x
g0 z=start_z
;podizanje sonde
m=me_probeDown


;korekcija koordinatnog sistema ako se trazi
IF(KOREKCIJA==1)
  $P_UIFR[me_frame,Z,FI]=-me_W_result
  msg("$66023")
ENDIF

;rekalibracija ako se trazi
IF(KOREKCIJA==3)
  me_W_Position=me_W_result
  msg("$66023")
ENDIF

m17

greska:

SETAL(65002)
M00
M96

m17

;pocetak kalibracije
KALIBRACIJA:
;sonda mora biti rucno podignuta i dovedena u  žljeb na komadu
;trazimo kontakt po Z osi u plus smeru
g1 Z=IC(me_distance) F=me_feed MEAS=me_probenumber
;ako nemamo kontak  - greska
IF(($AC_MEA[me_probenumber]==0) AND (TEST>0)) GOTOF GRESKA_KALIBRACIJE
;u slucaju kontakta prepsujemo belezimo rezulztat
Me_W_Result1=$AA_MW[Z]
;varcamo se nazad
G0 Z=Start_Z
;i merimo u suprotnu stranu
g1 Z=IC(-me_distance) F=me_feed MEAS=me_probenumber
;ako nemamo kontak  - greska
IF(($AC_MEA[me_probenumber]==0) AND (TEST>0)) GOTOF GRESKA_KALIBRACIJE
;u slucaju kontakta prepsujemo belezimo rezulztat
Me_W_Result2=$AA_MW[Z]
;podesavanje ostalih promenljivih
me_W_diameter = start_X
me_W_position = 0.5*(me_W_result1 + me_W_result2)
;ispis poruke
msg("$66021 "<<Me_W_Position)

M17

