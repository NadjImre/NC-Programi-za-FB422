PROC REKALIBACIJA
DEF INT BROJAC

G500X0G0T0D0
G0B178;A0

me_tool="zond"
me_tool_number = gett("zond")
me_tool_Dnumber = 1
me_diameter = 31.69
me_position = 502
me_distance = 5
me_feed = 60
me_ProbeUp = 32
me_ProbeDown = 33
me_probe_number = 1
me_status = 15317
me_frame = 2
me_tolerance = 0.1
me_with_Caxis = 0
me_Caxis_Position = 45
me_RepetitionCount = 1
me_MeasureCount = 1
me_ReturnMode = 16
me_Probe_AutoUP =  64
STOPRE
;merenje za rekalibraciju
;Brojac pokusaja
Brojac=0
ponovo:
;merenje
MS140
;rekalibracija
$tc_dp4[me_tool_number,me_tool_dnumber]=$tc_dp4[me_tool_number,me_tool_dnumber]-0.5*me_avg
;provera pokusaja
if (brojac>5) gotof kraj
;provera velicine ako je velika ponovo
brojac=brojac+1
if (ABS(me_avg)>0.002) gotob ponovo

KRAJ:
G500X0G0T0D0
M33


M17

